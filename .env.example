# Server-only credentials. Never prefix these with VITE_.
# Native Upstash integration in Vercel injects this pair automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Direct Upstash accounts may use these names instead (both are supported):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Unique strong owner key; production value is stored encrypted in Vercel.
BOOKING_ADMIN_TOKEN=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
# Optional, verified Spacemail sending configuration (server only):
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bookings@mooncrabsiargao.com
SMTP_SENDER_VERIFIED=false
# Optional private exports for the existing KASAG room:
AIRBNB_ICAL_URL=
BOOKING_COM_ICAL_URL=
# Only required if enabling the protected scheduled endpoints:
CRON_SECRET=
